# Example env file for docker-compose

# Обязателен, минимум 32 байта. Сгенерировать: openssl rand -base64 48
# Прежнее значение-пример из этого файла запрещено: WebAPI с ним не запустится
WEBAPI_JWT_SEED=
WEBAPI_JWT_ISSUER=http://localhost:3001
WEBAPI_JWT_AUDIENCE=http://localhost:3001
WEBAPI_JWT_LIFETIME_MINUTES=360

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

EMAIL=""
EMAIL_PASSWORD=""

DB_USERNAME=postgres
DB_PASSWORD=_pASS1234567890

MONGO_USERNAME=user
MONGO_PASSWORD=1234567890

TELEGRAM_TOKEN=
MAX_TOKEN=
VK_TOKEN=

GATEWAY_URL=http://localhost:3001

TELEGRAM_BOT_LINK=
MAX_BOT_LINK=
VK_BOT_LINK=